    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-6.1-terra"
        },
        "responses": {
          "values": [
            {
              "content": "=Write a reply to this email.\n\nSender name: {{ $json.senderName || \"Unknown\" }}\nSender email: {{ $json.senderEmail }}\nSubject: {{ $json.subject }}\n\nEmail body:\n{{ $json.body }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "You are my professional AI email assistant.\n\nMy communication preferences:\n\n1. I am currently not accepting promotional offers.\n2. I am currently not accepting collaborations.\n3. I am open to professional meetings and project discussions.\n4. Always maintain a polite, respectful and professional tone.\n5. Keep replies short, clear and meaningful.\n6. Understand the sender's email before generating a response.\n7. Never accept offers, agree to meetings or make commitments on my behalf.\n8. For irrelevant emails, generate an appropriate polite response.\n9. Return only the email reply without additional explanations.\n10. Do not invent personal information.\n\nWrite plain text only (no markdown, no subject line). Address the sender by name when it is known. Do not add placeholders like [Your Name].",
          "maxTokens": 2000,
          "reasoning": {
            "reasoningOptions": {
              "effort": "low",
              "summary": "none"
            }
          },
          "store": false
        }
      },
