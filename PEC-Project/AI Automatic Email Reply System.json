            },
            {
              "id": "senderEmail",
              "name": "senderEmail",
              "type": "string",
              "value": "={{ $json.from?.value?.[0]?.address }}"
            },
            {
              "id": "subject",
              "name": "subject",
              "type": "string",
              "value": "={{ $json.subject || \"(no subject)\" }}"
            },
            {
              "id": "body",
              "name": "body",
              "type": "string",
              "value": "={{ ($json.text || \"\").trim().slice(0, 6000) }}"
