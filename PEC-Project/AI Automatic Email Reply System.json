    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "safe-to-reply",
              "leftValue": "={{ (() => { const from = ($json.from?.value?.[0]?.address || \"\").toLowerCase(); const labels = $json.labelIds || []; const body = ($json.text || \"\").trim(); const content = (($json.subject || \"\") + \" \" + body.slice(0, 3000)).toLowerCase(); const automated = /(no-?reply|do-?not-?reply|mailer-daemon|postmaster|notifications?@|alerts?@|bounce)/.test(from); const sensitive = /(\\botp\\b|one[- ]time (password|code|pin)|verification code|security code|passcode|password reset|reset your password|forgot password|\\bbank|account statement|transaction|debited|credited|credit card|debit card|\\bupi\\b|net ?banking|login attempt|sign[- ]in attempt|security alert|confidential|out of office|automatic reply|auto-?reply|delivery status notification|undeliverable)/.test(content); const blockedLabel = [\"SENT\", \"DRAFT\", \"SPAM\", \"TRASH\"].some(l => labels.includes(l)); return from && body && !automated && !sensitive && !blockedLabel ? \"yes\" : \"no\"; })() }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "c80e0a76-8326-4597-9f44-d560ac26b26c",
      "name": "Is Safe To Reply",
